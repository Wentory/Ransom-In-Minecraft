# Publish only sources, build configuration, wrapper, license and README.
/*
!/src/
!/gradle/
!/common/
!/.gitignore
!/LICENSE
!/images/
!/README.md
!/build.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/settings.gradle

# Generated build output and local runtime files at every module depth.
**/build/
**/.gradle/
**/run/
**/run-*/
**/logs/
**/crash-reports/
**/out/
**/.idea/
**/.vscode/
*.iml
*.class
*.log
.DS_Store
hs_err_pid*
replay_pid*

# Local planning, release notes and porting records stay on disk only.
CHANGELOG.md
ROADMAP.md
PORTING*.md
AGENTS.md
